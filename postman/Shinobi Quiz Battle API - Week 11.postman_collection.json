      "name": "Module 2 - Sessions and Joining",
      "item": [
        {
          "name": "01 - Host starts a game",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Host can start a game - 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.collectionVariables.set(\"code\", response.joinCode);\r\n\r\npm.test(\"Game code is saved\", function () {\r\n    pm.expect(pm.collectionVariables.get(\"code\")).to.be.a(\"string\");\r\n    pm.expect(pm.collectionVariables.get(\"code\")).to.match(/^[1-9][0-9]{5}$/);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Count-Type",
                "value": "application/json"
              },
              {
                "key": "X-Demo-User",
                "value": "24179712"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"questionSetId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3001/api/v1/sessions",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3001",
              "path": [
                "api",
                "v1",
                "sessions"
              ]
            }
          },
          "response": []
        },
